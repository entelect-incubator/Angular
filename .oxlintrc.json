{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "rules": {
    "eslint/no-unused-vars": "error",
    "typescript/no-explicit-any": "error"
  },
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/.angular/**",
    "**/coverage/**",
    "**/package-lock.json"
  ]
}
